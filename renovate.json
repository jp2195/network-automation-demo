{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "kubernetes": {
    "managerFilePatterns": ["/^workloads/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Argo CD ApplicationSet chart entries served from an HTTPS Helm repo",
      "managerFilePatterns": ["/^argocd/manifests/.+\\.ya?ml$/"],
      "matchStrings": [
        "chart:\\s*\\n\\s+repo:\\s*(?<registryUrl>https://\\S+)\\s*\\n\\s+name:\\s*(?<depName>\\S+)\\s*\\n\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Argo CD ApplicationSet chart entries served from an OCI registry (repo has no scheme)",
      "managerFilePatterns": ["/^argocd/manifests/.+\\.ya?ml$/"],
      "matchStrings": [
        "chart:\\s*\\n\\s+repo:\\s*(?<packageName>[a-z0-9.-]+\\.[a-z]{2,}/\\S+)\\s*\\n\\s+name:\\s*(?<depName>\\S+)\\s*\\n\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "packageNameTemplate": "{{{packageName}}}/{{{depName}}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Valkey chart pulled from the valkey-helm git repo at a valkey-X.Y.Z tag",
      "managerFilePatterns": ["/^argocd/manifests/platform/valkey\\.yaml$/"],
      "matchStrings": [
        "repo:\\s*(?<packageName>https://github\\.com/valkey-io/valkey-helm\\.git)\\s*\\n\\s+name:\\s*(?<depName>\\S+)\\s*\\n\\s+version:\\s*(?<currentValue>valkey-\\S+)"
      ],
      "depNameTemplate": "valkey-helm",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "regex:^valkey-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Argo CD bootstrap chart version",
      "managerFilePatterns": ["/^bootstrap/argocd-install\\.sh$/"],
      "matchStrings": ["ARGOCD_CHART_VERSION:-(?<currentValue>[^}\\s]+)}"],
      "depNameTemplate": "argo-cd",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster imageName (not a container image field the kubernetes manager knows)",
      "managerFilePatterns": ["/^workloads/.+\\.ya?ml$/"],
      "matchStrings": ["imageName:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Image constants in tools/render (single source for rendered topology/WFTs/versions.yaml)",
      "managerFilePatterns": ["/^tools/render/constants\\.go$/"],
      "matchStrings": [
        "Image\\w+\\s*=\\s*\"(?<depName>[a-z0-9.-]+(?:/[a-z0-9._-]+)*):(?<currentValue>[^\"/:@]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinned pip requirements inside Dockerfile RUN pip install lines",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["[\\s\"](?<depName>[A-Za-z0-9][A-Za-z0-9._-]*)(?:\\[[^\\]]*\\])?==(?<currentValue>[0-9][^\\s\"]*)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Images built and pushed to the in-cluster registry by `make build` are not versioned upstream",
      "matchPackageNames": ["/^atlas-demo-registry/"],
      "enabled": false
    },
    {
      "description": "Generated by tools/render -- bump tools/render/constants.go instead, then run `go run ./tools/render` and `go test ./tools/render -run TestGoldenOutputs -update`",
      "matchFileNames": [
        "workloads/versions.yaml",
        "workloads/topology/**",
        "workloads/eventing/wft-*.yaml",
        "tools/render/testdata/**"
      ],
      "enabled": false
    },
    {
      "description": "The valkey git chart's appVersion is overridden in platform/values/valkey.yaml; this entry must not also be picked up as an HTTPS Helm repo",
      "matchFileNames": ["argocd/manifests/platform/valkey.yaml"],
      "matchDatasources": ["helm"],
      "enabled": false
    },
    {
      "groupName": "platform Helm charts (non-major)",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["argocd/manifests/**", "bootstrap/**"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "container images (non-major)",
      "matchDatasources": ["docker"],
      "matchFileNames": ["workloads/**", "tools/render/constants.go", "images/**"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "python image deps (non-major)",
      "matchDatasources": ["pypi"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "go modules (non-major)",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Major bumps here have broken (or are known to risk breaking) the demo: CRD/API churn, NOS config schema, chart value renames. Never automerge; review by hand.",
      "matchPackageNames": [
        "ghcr.io/srl-labs/clabernetes/clabernetes",
        "ghcr.io/nokia/srlinux",
        "ghcr.io/netbox-community/netbox-chart/netbox",
        "prom/snmp-exporter",
        "kube-prometheus-stack",
        "argo-cd",
        "argo-workflows"
      ],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["breaking-risk"],
      "prBodyNotes": [
        ":warning: Major bump of a dependency flagged `breaking-risk`. Check upstream release notes / upgrade guide and run the full demo (`make up`, `make demo-cut`) before merging."
      ]
    }
  ]
}
